# LLM provider: Gemini only. Get a key from https://aistudio.google.com/apikey
# Required -- the API refuses to start generation without it.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Factual rephrasing, not creative writing — keep this low (0.0-0.3).
LLM_TEMPERATURE=0.1
LLM_TIMEOUT_SECONDS=60

# Maximum age (seconds) a signed run may have before it's refused as stale.
# Development default is 86400 (24h). PRODUCTION MUST SET THIS EXPLICITLY
# to match the actual business-approved staleness window.
MAX_RUN_AGE_SECONDS=86400

# Allocation weights must sum to 100% within this many percentage points.
ALLOCATION_SUM_TOLERANCE_PCT=0.5

# Ed25519 public key used to verify signed runs. In production this should
# point to a key managed by your HSM/KMS/signing service, not a file
# generated by scripts/generate_dev_keys.py.
PUBLIC_KEY_PATH=./keys/dev_public_key.pem

# Only used by the reference signer in src/signing/sign.py (tests/dev
# tooling). The Disclosure Generator API never signs anything.
PRIVATE_KEY_PATH=./keys/dev_private_key.pem

AUDIT_LOG_PATH=./data/audit.jsonl

# Mounts POST /dev/sign (signs an arbitrary payload with the local dev
# private key, for the test frontend in frontend/). NEVER set true outside
# local development -- anyone who can reach it can forge signed runs.
ENABLE_DEV_TOOLS=true

# Origins allowed to call this API via CORS. Only needed because the test
# frontend (frontend/) runs on a different port than this API.
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
