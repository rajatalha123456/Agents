SECRET_KEY=change-me-in-production
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# Leave unset to use local SQLite. Example for Postgres:
# DATABASE_URL=postgres://user:password@localhost:5432/cashflow_agent
# DATABASE_URL=sqlite:///db.sqlite3

# CORS is open to any localhost/127.0.0.1 port (see settings.py) so the dev
# frontend works no matter which port Vite picks.

# Required for the AI Chat and What-If explanation features.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest
