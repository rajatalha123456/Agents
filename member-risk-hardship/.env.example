ADMIN_API_KEY=replace-with-a-long-random-secret
RISK_DATA_DIR=runtime
# none disables agent endpoints; direct ML tools still work.
LLM_PROVIDER=none
LLM_BASE_URL=http://localhost:11434
LLM_MODEL=qwen3
LLM_API_KEY=
OPENAI_API_KEY=''
OPENAI_MODEL=gpt-4.1-mini
# Required for any non-loopback LLM endpoint. Only aggregate tool results leave the service.
ALLOW_EXTERNAL_LLM=false
MAX_UPLOAD_MB=20
RATE_LIMIT_PER_MINUTE=120
