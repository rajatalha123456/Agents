# --- Storage ---
DATABASE_URL=sqlite:///./data/copilot.db
VECTOR_STORE_DIR=./data/vector_store
RAW_DOCS_DIR=./data/raw_documents

# --- Embeddings (local, free — matches sentence-transformers) ---
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# --- LLM provider: "anthropic" or "gemini" or "ollama" ---
LLM_PROVIDER=gemini

# Anthropic (hosted, paid)
ANTHROPIC_API_KEY=your_key_here
ANTHROPIC_MODEL=claude-sonnet-4-6

# Gemini (hosted, FREE TIER — get a key at https://aistudio.google.com/apikey)
GEMINI_API_KEY=your_key_here
GEMINI_MODEL=gemini-2.5-flash

# Ollama (local / on-prem, fully free, no key — use if data-residency requires no external calls)
OLLAMA_MODEL=llama3.1
OLLAMA_HOST=http://localhost:11434

# --- Retrieval tuning ---
TOP_K_SEMANTIC=16
TOP_K_KEYWORD=50
TOP_K_FINAL=20

# --- Auth (stub — wire to your real IdP/LDAP later) ---
SECRET_KEY=change_me_dev_only
